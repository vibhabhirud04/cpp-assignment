Develop a C++ program to represent campus Wi-Fi access points as vertices and direct network links as edges. Store the graph using an adjacency matrix. Accept access-point connections, display the matrix, and identify the access point or points having the maximum number of direct connections


#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    int n, e;

    cout << "Enter number of Wi-Fi access points: ";
    cin >> n;

    vector<string> ap(n);
    vector<vector<int> > adj(n, vector<int>(n, 0));

    for (int i = 0; i < n; i++) {
        cout << "Enter name of access point " << i + 1 << ": ";
        cin >> ap[i];
    }

    cout << "Enter number of direct network links: ";
    cin >> e;

    cout << "Enter connected access point indices (1-based):\n";

    for (int i = 0; i < e; i++) {
        int u, v;
        cin >> u >> v;

        if (u >= 1 && u <= n &&
            v >= 1 && v <= n && u != v) {
            adj[u - 1][v - 1] = 1;
            adj[v - 1][u - 1] = 1;
        } else {
            cout << "Invalid connection. Enter again:\n";
            i--;
        }
    }

    cout << "\nAdjacency Matrix:\n    ";

    for (int i = 0; i < n; i++) {
        cout << ap[i] << " ";
    }
    cout << "\n";

    for (int i = 0; i < n; i++) {
        cout << ap[i] << "   ";

        for (int j = 0; j < n; j++) {
            cout << adj[i][j] << "   ";
        }
        cout << "\n";
    }

    vector<int> degree(n, 0);
    int maxConnections = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            degree[i] += adj[i][j];
        }

        if (degree[i] > maxConnections) {
            maxConnections = degree[i];
        }
    }

    cout << "\nMaximum direct connections: "
         << maxConnections << "\n";

    cout << "Access point(s) with maximum connections:\n";

    for (int i = 0; i < n; i++) {
        if (degree[i] == maxConnections) {
            cout << ap[i] << " ("
                 << degree[i] << " connections)\n";
        }
    }

    return 0;
}
