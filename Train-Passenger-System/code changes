## Problem Statement: Train Passenger Record System Using Singly Linked List
Develop a menu-driven **Train Passenger Record System using C++ and a singly linked list** to manage passenger information efficiently. Each passenger record should contain the passenger ID, name, age, starting destination, final destination, and seat number.
The program should handle invalid menu inputs, display appropriate messages when records are not found or the list is empty, and allow users to perform multiple operations until they choose to exit.

#include <iostream>
#include <string>
using namespace std;

// Structure to store passenger details using a singly linked list
struct Passenger {
    int id;                       // Stores passenger ID
    string name;                  // Stores passenger name
    string startingDestination;   // Stores starting destination
    string finalDestination;     // Stores final destination
    int age;                      // Stores passenger age
    string seatLocation;          // Stores passenger seat number
    Passenger* next;              // Pointer to the next passenger node
};

// Head pointer points to the first passenger node
Passenger* head = NULL;

// Function to add a new passenger record
void addPassenger() {
    // Dynamically allocate memory for a new passenger node
    Passenger* p = new Passenger;

    // Accept passenger ID
    cout << "\nEnter Passenger ID: ";
    cin >> p->id;

    // Accept passenger name
    cout << "Enter Passenger Name: ";
    cin >> ws;
    getline(cin, p->name);

    // Accept passenger age
    cout << "Enter Passenger Age: ";
    cin >> p->age;

    // Accept the starting destination
    cout << "Enter Starting Destination: ";
    cin >> ws;
    getline(cin, p->startingDestination);

    // Accept the final destination
    cout << "Enter Final Destination: ";
    getline(cin, p->finalDestination);

    // Accept the passenger's seat number, such as S23
    cout << "Enter Seat Number: ";
    cin >> p->seatLocation;

    // Set the next pointer to NULL because this is a new node
    p->next = NULL;

    // If the linked list is empty, make the new node the first node
    if (head == NULL) {
        head = p;
    } else {
        // Traverse the linked list to find the last passenger node
        Passenger* temp = head;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        // Attach the new passenger node at the end of the list
        temp->next = p;
    }

    // Display a success message
    cout << "\nPassenger added successfully!\n";
}

// Function to delete a passenger using passenger ID
void deletePassenger() {
    int id;

    // Accept the ID of the passenger to be deleted
    cout << "\nEnter Passenger ID to delete: ";
    cin >> id;

    // Check whether the linked list is empty
    if (head == NULL) {
        cout << "No passenger records found.\n";
        return;
    }

    // If the first passenger matches the given ID, delete the first node
    if (head->id == id) {
        Passenger* temp = head;
        head = head->next;
        delete temp;

        cout << "Passenger deleted successfully.\n";
        return;
    }

    // Traverse the list to find the passenger before the node to delete
    Passenger* temp = head;

    while (temp->next != NULL && temp->next->id != id) {
        temp = temp->next;
    }

    // If the passenger ID is not found
    if (temp->next == NULL) {
        cout << "Passenger not found.\n";
    } else {
        // Remove the matching passenger node from the linked list
        Passenger* del = temp->next;
        temp->next = del->next;

        // Free the memory occupied by the deleted node
        delete del;

        cout << "Passenger deleted successfully.\n";
    }
}

// Function to search for a passenger using passenger ID
void searchPassenger() {
    int id;

    // Accept the passenger ID to search for
    cout << "\nEnter Passenger ID to search: ";
    cin >> id;

    // Start searching from the first node
    Passenger* temp = head;

    // Traverse the linked list until the passenger is found or the list ends
    while (temp != NULL) {
        if (temp->id == id) {
            cout << "\nPassenger Found!\n";

            // Display the passenger's personal details
            cout << "Passenger ID         : " << temp->id << endl;
            cout << "Passenger Name       : " << temp->name << endl;
            cout << "Passenger Age        : " << temp->age << endl;

            // Display the passenger's travel details
            cout << "Starting Destination : "
                 << temp->startingDestination << endl;
            cout << "Final Destination    : "
                 << temp->finalDestination << endl;

            // Display the assigned seat number
            cout << "Seat Number          : "
                 << temp->seatLocation << endl;

            return;
        }

        // Move to the next passenger node
        temp = temp->next;
    }

    // Display a message if the passenger ID does not exist
    cout << "Passenger not found.\n";
}

// Function to display the records of all passengers
void displayPassengers() {
    // Check whether any passenger records exist
    if (head == NULL) {
        cout << "\nNo passenger records found.\n";
        return;
    }

    // Start displaying records from the first node
    Passenger* temp = head;

    cout << "\n===== TRAIN PASSENGER RECORDS =====\n";

    // Traverse the linked list and display every passenger's details
    while (temp != NULL) {
        cout << "\nPassenger ID         : " << temp->id << endl;
        cout << "Passenger Name       : " << temp->name << endl;
        cout << "Passenger Age        : " << temp->age << endl;

        // Display the starting and final destinations
        cout << "Starting Destination : "
             << temp->startingDestination << endl;
        cout << "Final Destination    : "
             << temp->finalDestination << endl;

        // Display the passenger's seat number
        cout << "Seat Number          : "
             << temp->seatLocation << endl;

        cout << "-----------------------------------\n";

        // Move to the next passenger node
        temp = temp->next;
    }
}

// Main function: controls the menu and program execution
int main() {
    int choice;

    // Repeat the menu until the user chooses to exit
    do {
        cout << "\n===== TRAIN PASSENGER RECORD SYSTEM =====";
        cout << "\n1. Add Passenger";
        cout << "\n2. Delete Passenger";
        cout << "\n3. Search Passenger";
        cout << "\n4. Display Passengers";
        cout << "\n5. Exit";

        // Accept the user's menu choice
        cout << "\nEnter your choice: ";
        cin >> choice;

        // Handle non-numeric input entered for the menu choice
        if (cin.fail()) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "\nInvalid input! Please enter a number.\n";
            continue;
        }

        // Execute the operation selected by the user
        switch (choice) {
            case 1:
                addPassenger();       // Add a new passenger
                break;

            case 2:
                deletePassenger();    // Delete a passenger by ID
                break;

            case 3:
                searchPassenger();    // Search for a passenger by ID
                break;

            case 4:
                displayPassengers();  // Display all passenger records
                break;

            case 5:
                cout << "\nExiting program...\n";
                break;

            default:
                // Handle an invalid menu option
                cout << "\nInvalid choice! Please try again.\n";
        }

    } while (choice != 5);

    // Release the dynamically allocated memory of all remaining nodes
    while (head != NULL) {
        Passenger* temp = head;
        head = head->next;
        delete temp;
    }

    // Indicate successful program termination
    return 0;
