
#include <iostream>
#include <algorithm>
using namespace std;

// Node structure
struct Node {
    int data, height;
    Node *left, *right;

    Node(int value) {
        data = value;
        height = 1;
        left = right = NULL;
    }
};

int rotationCount = 0;

// Get height
int getHeight(Node* node) {
    if (node == NULL)
        return 0;
    return node->height;
}

// Calculate balance factor
int getBalance(Node* node) {
    if (node == NULL)
        return 0;

    return getHeight(node->left) -
           getHeight(node->right);
}

// Left rotation for RR case
Node* leftRotate(Node* x) {
    Node* y = x->right;
    Node* T2 = y->left;

    cout << "\nRR imbalance at node " << x->data;
    cout << "\nBefore rotation:";
    cout << "\nBF of " << x->data
         << " = " << getBalance(x);
    cout << "\nBF of " << y->data
         << " = " << getBalance(y) << endl;

    // Perform left rotation
    y->left = x;
    x->right = T2;

    // Update heights
    x->height = 1 + max(getHeight(x->left),
                        getHeight(x->right));

    y->height = 1 + max(getHeight(y->left),
                        getHeight(y->right));

    rotationCount++;

    cout << "After rotation:";
    cout << "\nBF of " << x->data
         << " = " << getBalance(x);
    cout << "\nBF of " << y->data
         << " = " << getBalance(y) << endl;

    return y;
}

// Insert node
Node* insert(Node* root, int key) {
    if (root == NULL)
        return new Node(key);

    if (key < root->data)
        root->left = insert(root->left, key);
    else if (key > root->data)
        root->right = insert(root->right, key);
    else
        return root;

    root->height = 1 + max(getHeight(root->left),
                           getHeight(root->right));

    int balance = getBalance(root);

    // RR case
    if (balance < -1 &&
        key > root->right->data)
        return leftRotate(root);

    return root;
}

// Display tree in preorder
void display(Node* root) {
    if (root == NULL)
        return;

    cout << root->data
         << "(BF=" << getBalance(root) << ") ";

    display(root->left);
    display(root->right);
}

// Test an insertion sequence
void testSequence(int arr[], int n, const char* name) {
    Node* root = NULL;
    rotationCount = 0;

    cout << "\n\n--- " << name << " ---\n";
    cout << "Elements: ";

    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
        root = insert(root, arr[i]);
    }

    cout << "\n\nFinal AVL Tree (Preorder): ";
    display(root);

    cout << "\nTotal rotations performed: "
         << rotationCount << endl;
}

// Main function
int main() {
    int sequence1[] = {10, 20, 30};
    int sequence2[] = {5, 10, 15, 20, 25};

    testSequence(sequence1, 3, "Test 1");
    testSequence(sequence2, 5, "Test 2");

    return 0;
}
