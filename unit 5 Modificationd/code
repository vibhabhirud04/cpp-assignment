Problem Statement
Develop a C++ program to represent campus Wi-Fi access points as vertices and direct network links as edges using an adjacency matrix. The program should accept access-point connections, display the adjacency matrix, and identify the access point or points having the maximum number of direct connections. Further, modify the program to support the insertion of a new vertex with its associated edges, deletion of a selected edge, and calculation and display of the degree and direct neighbours of a selected vertex.

  
#include <iostream>
#include <vector>
#include <string>
using namespace std;

// Display adjacency matrix
void displayGraph(vector<string> ap,
                  vector<vector<int> > adj, int n) {
    cout << "\nAdjacency Matrix:\n    ";

    for (int i = 0; i < n; i++)
        cout << ap[i] << " ";
    cout << "\n";

    for (int i = 0; i < n; i++) {
        cout << ap[i] << "   ";
        for (int j = 0; j < n; j++)
            cout << adj[i][j] << "   ";
        cout << "\n";
    }
}

// A. Insert a new vertex and its edges
void insertVertex(vector<string> &ap,
                  vector<vector<int> > &adj, int &n) {
    string name;
    cout << "Enter new access point name: ";
    cin >> name;

    for (int i = 0; i < n; i++) {
        adj[i].push_back(0);
    }

    vector<int> newRow(n + 1, 0);
    adj.push_back(newRow);
    ap.push_back(name);
    n++;

    int e, v;
    cout << "Enter number of edges for new vertex: ";
    cin >> e;

    cout << "Enter connected vertex indices (1 to "
         << n - 1 << "):\n";

    for (int i = 0; i < e; i++) {
        cin >> v;

        if (v >= 1 && v < n) {
            adj[n - 1][v - 1] = 1;
            adj[v - 1][n - 1] = 1;
        } else {
            cout << "Invalid vertex index. Try again.\n";
            i--;
        }
    }

    cout << "\nUpdated graph after insertion:";
    displayGraph(ap, adj, n);
}

// B. Remove a selected edge
void removeEdge(vector<string> ap,
                vector<vector<int> > &adj, int n) {
    int u, v;

    cout << "Enter two vertex indices to remove edge: ";
    cin >> u >> v;

    if (u >= 1 && u <= n && v >= 1 && v <= n &&
        u != v && adj[u - 1][v - 1] == 1) {
        adj[u - 1][v - 1] = 0;
        adj[v - 1][u - 1] = 0;

        cout << "Edge removed successfully.\n";
    } else {
        cout << "Invalid indices or edge does not exist.\n";
    }

    cout << "\nUpdated graph after edge removal:";
    displayGraph(ap, adj, n);
}

// C. Display degree and direct neighbours
void showDegree(vector<string> ap,
                vector<vector<int> > adj, int n) {
    int v, degree = 0;

    cout << "Enter vertex index to check: ";
    cin >> v;

    if (v < 1 || v > n) {
        cout << "Invalid vertex index.\n";
        return;
    }

    cout << "Direct neighbours of " << ap[v - 1] << ": ";
    degree = 0;

    for (int j = 0; j < n; j++) {
        if (adj[v - 1][j] == 1) {
            cout << ap[j] << " ";
            degree++;
        }
    }

    cout << "\nDegree of " << ap[v - 1]
         << " = " << degree << "\n";
}

int main() {
    int n, e;

    cout << "Enter number of Wi-Fi access points: ";
    cin >> n;

    if (n <= 0) {
        cout << "Number of access points must be positive.\n";
        return 0;
    }

    vector<string> ap(n);
    vector<vector<int> > adj(n, vector<int>(n, 0));

    for (int i = 0; i < n; i++) {
        cout << "Enter name of access point " << i + 1 << ": ";
        cin >> ap[i];
    }

    cout << "Enter number of direct network links: ";
    cin >> e;

    for (int i = 0; i < e; i++) {
        int u, v;
        cout << "Enter edge indices (1-based): ";
        cin >> u >> v;

        if (u >= 1 && u <= n && v >= 1 &&
            v <= n && u != v) {
            adj[u - 1][v - 1] = 1;
            adj[v - 1][u - 1] = 1;
        } else {
            cout << "Invalid edge. Try again.\n";
            i--;
        }
    }

    int choice;

    do {
        cout << "\n===== CAMPUS WI-FI GRAPH MENU =====\n";
        cout << "1. Display graph\n";
        cout << "2. Insert new vertex and edges\n";
        cout << "3. Remove an edge\n";
        cout << "4. Display degree and neighbours\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                displayGraph(ap, adj, n);
                break;

            case 2:
                insertVertex(ap, adj, n);
                break;

            case 3:
                removeEdge(ap, adj, n);
                break;

            case 4:
                showDegree(ap, adj, n);
                break;

            case 5:
                cout << "Program terminated.\n";
                break;

            default:
                cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 5);

    return 0;
}
